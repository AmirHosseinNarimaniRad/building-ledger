# Copy to deploy/.env on the server and fill in. Never commit the real file.
# Generate secrets with:  openssl rand -hex 24      (hex keeps them safe inside URLs)

DOMAIN=example.ir
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
# 32 random bytes, base64:  openssl rand -base64 32
# Losing it invalidates every resident link (they can be re-issued from the units page).
RESIDENT_TOKEN_KEY=

# SMS: console (codes and links only in the app log) | kavenegar | smsir. See deploy/SMS.md.
SMS_SENDER=console
# Kavenegar: API key from the panel, and the three template names you created.
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE_OTP=
KAVENEGAR_TEMPLATE_CHARGE=
KAVENEGAR_TEMPLATE_REMINDER=
# SMS.ir: API key from the panel, and the three template ids (numbers).
SMSIR_API_KEY=
SMSIR_TEMPLATE_OTP=
SMSIR_TEMPLATE_CHARGE=
SMSIR_TEMPLATE_REMINDER=

RECEIPT_EXTRACTOR=mock
KEEP_DAYS=14

# Optional: images/mirrors reachable from your server.
# APP_IMAGE=registry.example.ir/building-ledger:latest
# POSTGRES_IMAGE=postgres:16-alpine
# NGINX_IMAGE=nginx:1.27-alpine
# NODE_IMAGE=node:20-alpine
# NPM_REGISTRY=https://registry.npmjs.org/

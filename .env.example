# Copy to .env.local for development.

# Migrations run as the owner role; the app connects as app_user (created in step 1),
# which has no TRUNCATE or DDL rights on the ledger.
DATABASE_OWNER_URL=postgres://ledger_owner:ledger_owner_dev@localhost:5432/ledger
APP_DB_PASSWORD=app_user_dev
DATABASE_URL=postgres://app_user:app_user_dev@localhost:5432/ledger

# mock | vlm
RECEIPT_EXTRACTOR=mock
# console | panel
SMS_SENDER=console

# Where uploaded document images are stored (local disk behind the FileStore interface).
FILE_STORE_DIR=./storage

# Encrypts resident link tokens at rest (32 bytes, base64). Generate a new one per deployment:
#   node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'
RESIDENT_TOKEN_KEY=change-me
# Public base URL used in SMS links.
APP_URL=http://localhost:3000
